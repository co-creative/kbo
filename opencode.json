{
  "mcp": {
    "microsoft-learn": {
      "type": "remote",
      "enabled": true,
      "url": "https://learn.microsoft.com/api/mcp"
    },
    "azure": {
      "type": "local",
      "enabled": true,
      "command": [
        "npx",
        "-y",
        "@azure/mcp@3.0.0",
        "server",
        "start",
        "--read-only"
      ],
      "environment": {
        "AZURE_TOKEN_CREDENTIALS": "AzureCliCredential"
      }
    }
  }
}