@inherits LayoutComponentBase
@inject ReleaseProvider Releases
@inject NavigationManager Nav

<header class="top">
    <a class="brand" href="@Ui.Link("/", L)">KBO <span>search</span></a>
    <nav class="langs" aria-label="Language">
        @foreach (var lang in Lang.All)
        {
            <a class="@(lang == L ? "active" : null)" href="@Ui.SwitchLang(Nav, lang)" hreflang="@lang">@lang.ToUpperInvariant()</a>
        }
    </nav>
</header>

<main>
    @if (store is not null)
    {
        @Body
    }
    else
    {
        @* the page itself is not rendered: it needs the release *@
        <PageTitle>No data yet · KBO search</PageTitle>
        <h1>No data yet</h1>
        <p class="no-release">No KBO release is available yet. Try again in a few minutes.</p>
    }
</main>

<footer>
    @if (store is not null)
    {
        <text>KBO Open Data extract @store.Release.ExtractNumber, snapshot @store.Release.SnapshotDate ·
        @store.CompanyCount.ToString("N0") companies ·</text>
    }
    <a href="/api/release">API</a> · <a href="/openapi/v1.json">OpenAPI</a>
</footer>

@code {
    CompanyStore? store;
    string L => Ui.LangOf(Nav);

    protected override void OnParametersSet() => store = Releases.Current;
}
